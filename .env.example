# Required for Groq-backed planning and summarization
GROQ_API_KEY=gsk_your_key_here

# Optional model override
GROQ_MODEL=llama-3.3-70b-versatile

# Required for E2B sandbox execution
E2B_API_KEY=e2b_your_key_here

# Agent runtime defaults
AGENT_DB_PATH=data/agent_state.db
AGENT_MAX_FULL_EPISODES=25
AGENT_MAX_ITERATIONS=100000
AGENT_CYCLE_SLEEP_SECONDS=5

# Frontend origins for FastAPI CORS (comma-separated)
FRONTEND_ORIGINS=https://your-frontend-domain.com,http://localhost:5173

BACKEND_API_URL=http://localhost:8000